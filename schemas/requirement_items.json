{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/requirement_items",
  "title": "结构化需求条目与来源目录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "items"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "2.0"] },
    "job_id": { "type": "string", "pattern": "^job-" },
    "source_file": { "type": "string" },
    "source_files": { "type": "array", "items": { "type": "string" } },
    "source_catalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "2.0" } } },
      "then": {
        "required": ["source_catalog"],
        "properties": {
          "items": {
            "items": { "required": ["source_refs", "claims"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "document", "paragraph_index", "fragment_index", "excerpt", "content_hash"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "document": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "paragraph_index": { "type": "integer", "minimum": 1 },
        "fragment_index": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "excerpt_truncated": { "type": "boolean" },
        "pair_index": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "enum": ["baseline", "target"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-\\d{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" }
        },
          "claims": {
            "type": "array",
            "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        },
        "source_location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "section": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        "golden_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched"],
          "properties": {
            "matched": { "type": "boolean" },
            "golden_id": { "type": "string", "pattern": "^REQ-\\d{3,}$" }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "kind", "statement", "source_refs"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
        "kind": {
          "type": "string",
          "enum": ["normal", "validation", "boundary", "exception", "authorization", "state_transition", "data_consistency", "non_functional", "dependency"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" }
        }
      }
    }
  }
}
