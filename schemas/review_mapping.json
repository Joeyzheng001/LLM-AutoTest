{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/review_mapping",
  "title": "Code Review 三视图（模块 4 REVIEW，主笔：甲）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "mappings", "risks", "missing_features"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "2.0"] },
    "job_id": { "type": "string", "pattern": "^job-" },
    "mappings": {
      "type": "array",
      "description": "视图一：需求-代码映射表（requirements × interfaces，F-REVW-01/02）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "confidence"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
          "status": { "type": "string", "enum": ["implemented", "partial", "missing", "undetermined"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_quality": { "type": "string", "enum": ["behavior_path", "interface_only", "insufficient", "none"] },
          "claim_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "status", "confidence", "interface_ids", "evidence_refs", "met_conditions", "unmet_conditions", "verification_needed"],
              "properties": {
                "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
                "status": { "type": "string", "enum": ["implemented", "partial", "missing", "undetermined"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
                "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } },
                "met_conditions": { "type": "array", "items": { "type": "string" } },
                "unmet_conditions": { "type": "array", "items": { "type": "string" } },
                "verification_needed": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } },
              "code_location": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repo": { "type": "string" },
                  "file": { "type": "string" },
                  "start_line": { "type": "integer", "minimum": 1 },
                  "end_line": { "type": "integer" }
                }
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence_catalog": {
      "type": "array",
      "description": "程序脱敏并编号的代码证据目录，用于从评审结论回溯源码位置",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "category", "repo", "file", "start_line", "end_line", "excerpt"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^EVD-\\d{4,}$" },
          "category": { "type": "string", "minLength": 1 },
          "repo": { "type": "string" },
          "file": { "type": "string" },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "excerpt": { "type": "string", "maxLength": 520 },
          "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } }
        }
      }
    },
    "scan_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "repositories", "review_evidence_limited"],
      "properties": {
        "complete": { "type": "boolean" },
        "review_evidence_limited": { "type": "boolean" },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "status", "truncated_scope", "encoding_skipped"],
            "properties": {
              "repo": { "type": "string" },
              "status": { "type": "string" },
              "truncated_scope": { "type": "array", "items": { "type": "string" } },
              "encoding_skipped": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "视图二：风险清单（partial 自动进入，R-REVW-04；程序化派生，R-REVW-02）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "description"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "kind": { "type": "string", "enum": ["partial_implementation", "evidence_gap"] },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "action": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missing_features": {
      "type": "array",
      "description": "视图三：遗漏功能清单（提取 missing 条目，程序化派生保证一致）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "title"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "description": "第一批：高风险服务端行为的确定性证据门槛检查（无直接证据时不得判已实现）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "rule_id", "category", "status", "description"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
          "rule_id": { "type": "string", "pattern": "^EVID-" },
          "category": { "type": "string" },
          "status": { "type": "string", "enum": ["evidence_found", "needs_verification"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } }
        }
      }
    },
    "change_scope": {
      "type": "array",
      "description": "视图四：变更范围（C-09 双分支 diff；接口按 code_location.file 关联变更文件，程序化派生不经 LLM；无基线分支时为空数组）",
      "items": {
        "type": "object",
        "required": ["interface_id", "repo", "file", "change", "covered_by"],
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "repo": { "type": "string" },
          "file": { "type": "string", "description": "仓内相对路径" },
          "change": { "type": "string", "enum": ["added", "modified"] },
          "covered_by": {
            "type": "array",
            "description": "映射到该接口的需求条目（空 = 变更接口未被需求覆盖）",
            "items": { "type": "string", "pattern": "^REQ-\\d{3}$" }
          }
        }
      }
    },
    "call_chains": {
      "type": "array",
      "description": "接口实现附近静态提取的一跳调用链；无法提取时为空，不补造",
      "items": {
        "type": "object",
        "required": ["interface_id", "entry", "callees", "confidence"],
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "entry": { "type": "object" },
          "callees": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "const": "static_one_hop" }
        }
      }
    },
    "incremental_findings": {
      "type": "array",
      "description": "基线 diff 的增量评审发现，程序化派生",
      "items": {
        "type": "object",
        "required": ["severity", "kind", "description", "repo", "file"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "repo": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "removed_files": {
      "type": "array",
      "description": "基线→被测分支删除的文件（C-09；被测侧无源码可关联接口，单列）",
      "items": {
        "type": "object",
        "required": ["repo", "file"],
        "properties": {
          "repo": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "unmatched_changed_files": {
      "type": "array",
      "description": "变更但未关联任何接口定义文件的文件（C-09；业务逻辑层变更等——接口签名未变但行为可能变更，需人工复核）",
      "items": {
        "type": "object",
        "required": ["repo", "file", "change"],
        "properties": {
          "repo": { "type": "string" },
          "file": { "type": "string" },
          "change": { "type": "string", "enum": ["added", "modified"] }
        }
      }
    },
    "review_log": {
      "type": "array",
      "description": "人工审核记录（F-REVW-06：通过/驳回 + 回流；E-REVIEW-03 闭环）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "decision", "timestamp"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "reason": { "type": "string" },
          "resubmitted": { "type": "boolean", "description": "驳回后是否已回流重新生成" },
          "timestamp": { "type": "string", "format": "date-time", "description": "UTC ISO-8601" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "evidence_catalog", "scan_coverage", "deterministic_checks", "change_scope", "removed_files",
          "unmatched_changed_files", "call_chains", "incremental_findings"
        ],
        "properties": {
          "mappings": { "items": { "required": ["interface_ids", "claim_assessments", "evidence"] } }
        }
      }
    }
  ]
}
