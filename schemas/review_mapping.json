{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/review_mapping",
  "title": "Code Review 双视图（映射表 + 变更范围，模块 4 REVIEW，主笔：甲；C-108 起 risks/missing_features/incremental_findings 停产）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "mappings"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "2.0", "2.1"] },
    "job_id": { "type": "string", "pattern": "^job-" },
    "mappings": {
      "type": "array",
      "description": "视图一：需求-代码映射表（requirements × interfaces，F-REVW-01/02）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "confidence"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
          "claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CLM-\\d{3,}$" } },
          "claim_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "implemented", "partial", "missing", "undetermined"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "implemented": { "type": "integer", "minimum": 0 },
              "partial": { "type": "integer", "minimum": 0 },
              "missing": { "type": "integer", "minimum": 0 },
              "undetermined": { "type": "integer", "minimum": 0 }
            }
          },
          "status": { "type": "string", "enum": ["implemented", "partial", "missing", "undetermined"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "raw_confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "确定性门槛封顶前的原始置信度；仅当封顶实际压低数值时存在" },
          "confidence_capped": { "type": "boolean", "description": "true = confidence 被确定性证据门槛（min(x, 0.45)）压低过" },
          "evidence_quality": { "type": "string", "enum": ["behavior_path", "interface_only", "insufficient", "none"] },
          "claim_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "status", "confidence", "interface_ids", "evidence_refs", "met_conditions", "unmet_conditions", "verification_needed"],
              "properties": {
                "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
                "status": { "type": "string", "enum": ["implemented", "partial", "missing", "undetermined"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "raw_confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "确定性门槛封顶前的原始置信度；仅当封顶实际压低数值时存在" },
                "confidence_capped": { "type": "boolean", "description": "true = confidence 被确定性证据门槛（min(x, 0.45)）压低过" },
                "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
                "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } },
                "met_conditions": { "type": "array", "items": { "type": "string" } },
                "unmet_conditions": { "type": "array", "items": { "type": "string" } },
                "verification_needed": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } },
              "code_location": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repo": { "type": "string" },
                  "file": { "type": "string" },
                  "start_line": { "type": "integer", "minimum": 1 },
                  "end_line": { "type": "integer" }
                }
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence_catalog": {
      "type": "array",
      "description": "程序脱敏并编号的代码证据目录，用于从评审结论回溯源码位置",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "category", "repo", "file", "start_line", "end_line", "excerpt"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^EVD-\\d{4,}$" },
          "category": { "type": "string", "minLength": 1 },
          "repo": { "type": "string" },
          "file": { "type": "string" },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "excerpt": { "type": "string", "maxLength": 520 },
          "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
          "role": { "type": "string" }
        }
      }
    },
    "scan_coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "扫描覆盖率：complete=true 表示「仓库扫描完整、你已看到全部接口」。任何截断（证据池/接口证据/调用链）或完整性校验缺失都必须让它是 false，不能只报碰巧检测到的那一项",
      "required": [
        "complete",
        "repositories",
        "review_evidence_limited",
        "interface_evidence_truncated",
        "call_chain_truncated",
        "scan_integrity_complete"
      ],
      "properties": {
        "complete": { "type": "boolean" },
        "review_evidence_limited": { "type": "boolean", "description": "证据池触顶（文件数或条目数）" },
        "interface_evidence_truncated": {
          "type": "boolean",
          "description": "接口证据按上限截断（接口数超过 interface_evidence_limit）"
        },
        "interface_evidence_limit": { "type": "integer" },
        "interface_evidence_count": {
          "type": "integer",
          "description": "实际拥有接口实现源码证据的接口数"
        },
        "interface_evidence_missing": {
          "type": "array",
          "description": "没有对应接口实现源码证据的接口 ID；非空时 complete 必须为 false",
          "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" }
        },
        "call_chain_truncated": {
          "type": "boolean",
          "description": "调用链分析按上限截断（接口数超过 call_chain_limit）"
        },
        "call_chain_limit": { "type": "integer" },
        "interfaces_total": { "type": "integer" },
        "scan_integrity_complete": {
          "type": "boolean",
          "description": "接口还原阶段的完整性闭环门禁是否通过（发现文件数 == 解析成功数 + 失败数，且与 code_inventory 一致）"
        },
        "scan_integrity_reasons": {
          "type": "array",
          "description": "未通过的具体原因（照抄接口还原阶段的结论，不改写）",
          "items": { "type": "string" }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "status", "truncated_scope", "encoding_skipped"],
            "properties": {
              "repo": { "type": "string" },
              "status": { "type": "string" },
              "truncated_scope": { "type": "array", "items": { "type": "string" } },
              "encoding_skipped": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "change_scope_available": {
      "type": "boolean",
      "description": "是否配置并生成了基线/提交变更清单；false 与‘已配置但无变更’不同"
    },
    "risks": {
      "type": "array",
      "description": "已停产（C-108）：仅为历史产物回读兼容保留，新产物不再写入；由视图一 claim 级状态与视图二 risk_level 取代",
      "items": {
        "type": "object",
        "required": ["requirement_id", "description"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
          "claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CLM-\\d{3,}$" } },
          "kind": { "type": "string", "enum": ["partial_implementation", "evidence_gap"] },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "action": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missing_features": {
      "type": "array",
      "description": "已停产（C-108）：仅为历史产物回读兼容保留，新产物不再写入；由视图一 claim 级 missing 状态取代",
      "items": {
        "type": "object",
        "required": ["requirement_id", "title"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "title": { "type": "string", "minLength": 1 }
          ,"claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" }
          ,"claim_statement": { "type": "string" }
          ,"interface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } }
          ,"evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } }
          ,"unmet_conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "description": "第一批：高风险服务端行为的确定性证据门槛检查（无直接证据时不得判已实现）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "rule_id", "category", "status", "description"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
          "rule_id": { "type": "string", "pattern": "^EVID-" },
          "category": { "type": "string" },
          "status": { "type": "string", "enum": ["evidence_found", "needs_verification"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4,}$" } }
        }
      }
    },
    "change_scope": {
      "type": "array",
      "description": "视图二：变更范围（C-09 双分支 diff）。接口命中口径=定义文件被改 **或** 任一 related_files 被改（行为级）；事实字段程序化派生，impact_analysis 由 LLM 生成（C-108，编号经程序校验）；无基线分支时为空数组",
      "items": {
        "type": "object",
        "required": ["interface_id", "repo", "file", "change", "covered_by"],
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "repo": { "type": "string" },
          "file": { "type": "string", "description": "接口定义文件（仓内相对路径）" },
          "change": {
            "type": "string",
            "enum": ["added", "modified"],
            "description": "接口定义文件的变更类型；定义文件未变（仅关联文件变）时取关联文件的变更类型，来源见 matched_via"
          },
          "matched_via": {
            "type": "string",
            "enum": ["definition", "related_file"],
            "description": "definition=接口定义文件本身被改；related_file=定义文件没改，但依赖（Service/DTO/Entity/Enum）被改"
          },
          "related_changed_files": {
            "type": "array",
            "description": "落在变更清单里的关联文件",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "role": { "type": "string" },
                "change": { "type": "string", "enum": ["added", "modified"] }
              }
            }
          },
          "covered_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirement_id", "claim_ids", "status"],
              "properties": {
                "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
                "claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CLM-\\d{3,}$" } },
                "status": { "type": "string", "enum": ["implemented", "partial", "missing", "undetermined"] }
              }
            }
          },
          "evidence_level": {
            "type": "string",
            "enum": ["body", "callee", "file", "related_file", "none"],
            "description": "行级变更判定等级（来自接口还原的 change_evidence）：body=本体方法被改；callee=调用链上的代码被改；file=本体文件被改但改动行不在跨度内；related_file=仅关联文件被改"
          },
          "covered_by": {
            "type": "array",
            "description": "映射到该接口的需求条目（空 = 变更接口未被需求覆盖）",
            "items": { "type": "string", "pattern": "^REQ-\\d{3}$" }
          },
          "risk_level": {
            "type": "string",
            "enum": ["P0", "P1", "P2"],
            "description": "程序派生的回归优先级下限（原 incremental_findings 口径：未被需求覆盖/评审状态异常=P1，待核查=P2）；LLM 影响分析失败时的兜底展示"
          },
          "impact_analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "risk_level"],
            "description": "LLM 影响分析（C-108）：接口编号经程序校验，分析文本为模型生成，需人工复核",
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "impact_surface": { "type": "array", "items": { "type": "string" } },
              "test_suggestion": { "type": "string" },
              "risk_level": { "type": "string", "enum": ["P0", "P1", "P2"] }
            }
          }
        }
      }
    },
    "call_chains": {
      "type": "array",
      "description": "接口实现的静态递归调用链；新产物使用结构化 callee 节点，旧产物可保留一跳字符串",
      "items": {
        "type": "object",
        "required": ["interface_id", "entry", "callees", "analysis_method"],
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "entry": {
            "type": "object",
            "properties": {
              "repo": { "type": "string" },
              "file": { "type": "string" }
            }
          },
          "callees": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "file": { "type": "string" },
                    "role": { "type": "string" },
                    "start_line": { "type": ["integer", "null"], "minimum": 1 },
                    "end_line": { "type": ["integer", "null"], "minimum": 1 },
                    "depth": { "type": ["integer", "null"], "minimum": 1 },
                    "call_line": { "type": ["integer", "null"], "minimum": 1 }
                  }
                }
              ]
            }
          },
          "status": { "type": "string", "enum": ["complete", "partial"] },
          "resolved_calls": { "type": "integer", "minimum": 0 },
          "resolved_nodes": { "type": "integer", "minimum": 0 },
          "unresolved_calls": { "type": "integer", "minimum": 0 },
          "unresolved": { "type": "array" },
          "max_depth": { "type": "integer", "minimum": 0 },
          "analysis_method": {
            "type": "string",
            "description": "调用链分析方法标注（非置信度）：static_recursive=静态递归解析，legacy_static_one_hop=旧版一跳正则",
            "enum": ["static_recursive", "legacy_static_one_hop"]
          }
        }
      }
    },
    "incremental_findings": {
      "type": "array",
      "description": "已停产（C-108）：仅为历史产物回读兼容保留，新产物不再写入；其判定已映射为 change_scope[].risk_level",
      "items": {
        "type": "object",
        "required": ["severity", "kind", "description", "repo", "file"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "repo": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "removed_files": {
      "type": "array",
      "description": "基线→被测分支删除的文件（C-09；被测侧无源码可关联接口，单列）",
      "items": {
        "type": "object",
        "required": ["repo", "file"],
        "properties": {
          "repo": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "unmatched_changed_files": {
      "type": "array",
      "description": "变更但未关联任何接口定义文件的文件（C-09；业务逻辑层变更等——接口签名未变但行为可能变更，需人工复核）",
      "items": {
        "type": "object",
        "required": ["repo", "file", "change"],
        "properties": {
          "repo": { "type": "string" },
          "file": { "type": "string" },
          "change": { "type": "string", "enum": ["added", "modified"] },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "description": "LLM 盲区归因（C-108）：引用编号经程序校验（仅保留真实存在的接口/需求），归因理由为模型生成",
            "properties": {
              "likely_interfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" } },
              "likely_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-\\d{3}$" } },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    },
    "change_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nature", "overall_risk", "regression_advice"],
      "description": "LLM 变更总评（C-108）：变更性质/整体风险/回归建议；LLM 失败时整键缺省",
      "properties": {
        "nature": { "type": "string" },
        "overall_risk": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "regression_advice": { "type": "string" }
      }
    },
    "review_log": {
      "type": "array",
      "description": "人工审核记录（F-REVW-06：通过/驳回 + 回流；E-REVIEW-03 闭环）",
      "items": {
        "type": "object",
        "required": ["requirement_id", "decision", "timestamp"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "reason": { "type": "string" },
          "resubmitted": { "type": "boolean", "description": "驳回后是否已回流重新生成" },
          "timestamp": { "type": "string", "format": "date-time", "description": "UTC ISO-8601" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "evidence_catalog", "scan_coverage", "deterministic_checks", "change_scope", "removed_files",
          "unmatched_changed_files", "call_chains", "incremental_findings"
        ],
        "properties": {
          "mappings": { "items": { "required": ["interface_ids", "claim_assessments", "evidence"] } }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": "2.1" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "evidence_catalog", "scan_coverage", "deterministic_checks", "change_scope", "removed_files",
          "unmatched_changed_files", "call_chains"
        ],
        "properties": {
          "mappings": { "items": { "required": ["interface_ids", "claim_assessments", "evidence"] } }
        }
      }
    }
  ]
}
