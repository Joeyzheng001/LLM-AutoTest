{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/testcases",
  "title": "用例与脚本元数据（模块 5 GEN，主笔：丙）",
  "type": "object",
  "required": ["schema_version", "job_id", "cases"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "job_id": { "type": "string", "pattern": "^job-" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "interface_id", "category", "title", "expected", "script_path", "loadable"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-\\d{3}$" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$", "description": "F-GEN-04 溯源" },
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$", "description": "F-GEN-04 溯源（可追溯即携带）" },
          "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$", "description": "P0：原子需求声明溯源" },
          "testpoint_id": { "type": "string", "pattern": "^TP-\\d{3}$", "description": "F-GEN-04 溯源扩展：本条用例主要覆盖的测试点编号；程序兜底用例可省略" },
          "category": { "type": "string", "enum": ["normal", "boundary", "exception"], "description": "F-GEN-01：每接口三类各 ≥1" },
          "title": { "type": "string", "minLength": 1 },
          "params": {
            "type": "object",
            "description": "F-GEN-02：参数名与结构仅来自 interfaces.json，出现清单外参数即打回",
            "additionalProperties": true
          },
          "auth_mode": { "type": "string", "enum": ["inherit", "missing", "invalid"], "description": "认证会话模式：继承任务登录、缺失认证或伪造认证" },
          "expected": { "type": "string", "description": "预期结果描述（断言依据）" },
          "assertions": {
            "type": "array",
            "description": "可执行的响应体业务断言；空缺时执行器明确标记为仅状态码断言",
            "items": {
              "type": "object",
              "required": ["path", "op"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "op": { "type": "string", "enum": ["equals", "not_equals", "exists", "not_exists", "non_empty", "contains", "greater_than", "less_than"] },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "script_path": { "type": "string", "description": "生成的 pytest 脚本相对路径" },
          "loadable": { "type": "boolean", "description": "R-GEN-03：py_compile + 收集零 error 的校验结果" },
          "low_confidence": { "type": "boolean", "description": "X-GEN-03：unknown 参数用例低置信度注明" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "生成质量告警（v1.1 新增可选字段：X-GEN-01 接口跳过 / X-GEN-02 参数一致性二次不过放弃）",
      "items": { "type": "string" }
    },
    "testpoints": {
      "type": "array",
      "description": "程序化派生的需求/风险测试点，作为功能用例的可追溯设计依据"
    },
    "e2e_cases": {
      "type": "array",
      "description": "可选浏览器端到端用例；仅在任务启用时生成",
      "items": {
        "type": "object",
        "required": ["id", "case_type", "requirement_id", "title", "steps", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^E2E-\\d{3}$" },
          "case_type": { "const": "e2e" },
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3}$" },
          "claim_id": { "type": "string", "pattern": "^CLM-\\d{3,}$" },
          "testpoint_id": { "type": "string", "pattern": "^TP-\\d{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "object" } },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
