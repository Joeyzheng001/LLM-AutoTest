{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/requirement_diff",
  "title": "需求版本差异分析",
  "type": "object",
  "required": ["schema_version", "job_id", "has_baseline", "summary", "changes"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "2.0"]},
    "job_id": {"type": "string", "pattern": "^job-"},
    "has_baseline": {"type": "boolean", "const": true},
    "summary": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pair_index", "change_type", "title", "target_description", "baseline_description", "change_summary", "source_location"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^DIF-\\d{3}$"},
          "pair_index": {"type": "integer", "minimum": 1},
          "change_type": {"type": "string", "enum": ["added", "modified", "removed"]},
          "title": {"type": "string", "minLength": 1},
          "target_description": {"type": "string"},
          "baseline_description": {"type": "string"},
          "change_summary": {"type": "string", "minLength": 1},
          "source_location": {"type": "string"},
          "target_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
          "baseline_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
          "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}}
        }
      }
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "document", "paragraph_index", "fragment_index", "excerpt", "content_hash"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "document": {"type": "string", "minLength": 1},
          "section": {"type": "string"},
          "paragraph_index": {"type": "integer", "minimum": 1},
          "fragment_index": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "excerpt_truncated": {"type": "boolean"},
          "pair_index": {"type": "integer", "minimum": 1},
          "version": {"type": "string", "enum": ["baseline", "target"]}
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["source_catalog"],
        "properties": {
          "changes": {
            "items": {
              "required": ["target_source_refs", "baseline_source_refs", "source_refs"]
            }
          }
        }
      }
    }
  ]
}
