{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-autotest/defects",
  "title": "本地缺陷记录（模块 8 DEF，主笔：丙；D3 口径：本地文件，非 Jira）",
  "type": "object",
  "required": ["schema_version", "job_id", "defects"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "job_id": { "type": "string", "pattern": "^job-" },
    "defects": {
      "type": "array",
      "description": "R-DEF-01：仅断言失败进入；环境失败隔离于待环境确认（不入本清单）",
      "items": {
        "type": "object",
        "required": ["id", "case_id", "interface_id", "failure_reason", "reproduce", "status", "history", "is_fallback"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEF-\\d{3}$" },
          "case_id": { "type": "string", "pattern": "^TC-\\d{3}$", "description": "R-DEF-02 双向关联" },
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z]+-\\d{3}$" },
          "failure_reason": { "type": "string", "minLength": 1 },
          "reproduce": {
            "type": "object",
            "description": "复现步骤（F-DEF-01：用例脚本引用）",
            "required": ["script_path"],
            "properties": {
              "script_path": { "type": "string" },
              "params": { "type": "object", "additionalProperties": true }
            }
          },
          "status": {
            "type": "string",
            "enum": ["discovered", "retesting", "passed", "closed_suggested", "retained"],
            "description": "F-DEF-03：发现→复测中→复测通过→关闭建议/保留"
          },
          "based_on_new_version": { "type": "boolean", "description": "X-DEF-01：复测时代码已变更标注" },
          "is_fallback": { "type": "boolean", "description": "演示埋入缺陷（独立分支）随兜底标记透传（X-DEF-03）" },
          "history": {
            "type": "array",
            "description": "R-DEF-03：可审计生命周期（时间戳流转）",
            "items": {
              "type": "object",
              "required": ["event", "timestamp"],
              "properties": {
                "event": { "type": "string", "enum": ["discovered", "retest_started", "retest_passed", "retest_failed", "close_suggested", "retained"] },
                "timestamp": { "type": "string", "format": "date-time", "description": "UTC ISO-8601" }
              }
            }
          }
        }
      }
    }
  }
}
