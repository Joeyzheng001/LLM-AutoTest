# MiniMax 调用参数（orchestrator 使用）
# 采样参数显式配置、禁止硬编码；页面候选模型为 MiniMax-M3/M2.7/M2.5。
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL_NAME=MiniMax-M3
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
# MiniMax 批次调用可能较慢；超时只限制单次 HTTP 调用，不改变有限重试次数。
LLM_TIMEOUT_S=300
# LLM_SEED=

# PostgreSQL（部门部署必填）
# POSTGRES_PASSWORD 是数据库容器实际密码；DATABASE_URL 中的密码需 URL 编码。
POSTGRES_DB=autotest
POSTGRES_USER=autotest
POSTGRES_PASSWORD=
DATABASE_URL=
# 容器内源码根目录（不要改成 Windows 盘符；任务配置会自动使用该服务端路径）
REPOSITORIES_ROOT=/opt/repos
# Docker 宿主机源码目录挂载（可选）；映射到容器内的 /opt/repos。
# Linux 示例：/opt/repos；Windows Docker 示例：C:/autotest/repos
REPOSITORIES_HOST_ROOT=/opt/repos

# 产物生命周期（默认关闭自动清理；启用后先移动到 .trash 回收区）
# ARTIFACT_RETENTION_DAYS=0
# ARTIFACT_TRASH_GRACE_DAYS=7
# ARTIFACT_CLEANUP_INTERVAL_S=3600
# 审计事件保留（仅清理数据库事件，不删除任务产物）
# AUDIT_RETENTION_DAYS=90
# AUDIT_CLEANUP_INTERVAL_S=3600

# 可选 S3/MinIO 证据镜像（本地文件仍为默认主读源）
# ARTIFACT_STORAGE_BACKEND=local
# 启用 object-store profile 时使用已验证的固定镜像；不要使用 latest。
MINIO_IMAGE=minio/minio:RELEASE.2024-06-13T22-53-53Z
# ARTIFACT_STORAGE_BUCKET=autotest-evidence
# ARTIFACT_STORAGE_ENDPOINT=http://minio:9000
# ARTIFACT_STORAGE_REGION=us-east-1
# ARTIFACT_STORAGE_ACCESS_KEY=
# ARTIFACT_STORAGE_SECRET_KEY=
# ARTIFACT_STORAGE_PREFIX=llm-autotest
# ARTIFACT_STORAGE_VERIFY_TLS=true

# 单用户部署：浏览器不显示也不需要填写平台技术令牌，统一以服务端 admin 身份运行。
# 需要接入企业 SSO / 多用户项目权限时，改为 false，再配置下方访问令牌映射。
AUTOTEST_SINGLE_USER_MODE=true

# 多用户模式访问令牌映射（启用后必须带 Bearer Token + X-Project-Id）
# 可选配额字段：max_concurrent_jobs、daily_job_limit、project_quotas（项目级覆盖）
# 单用户模式下仍可保留令牌映射，关闭单用户开关后立即生效。
AUTOTEST_ACCESS_TOKENS_JSON=
