# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
# 沙箱内跑 pytest 必须把 basetemp 指到工作区内（默认 tmp 路径 mkdir 被拦），
# 这些目录是运行期产物，不入库。
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# 注意：uv.lock 必须入库（docs/09 第一章：依赖锁定，CI uv sync --frozen 依赖锁文件）

# Java
target/
*.class

# Node
node_modules/
dist/

# 环境与密钥（禁止提交，红线见 docs/09 第一章）
.env
.env.*
!deploy/.env.example
deploy/.env
# 部署辅助脚本含服务器凭据（C-18 云部署），绝不入库
deploy/remote_exec.py

# 运行时产物（按任务 ID 分目录，运行时生成，不入库）
/data/
volumes/
# 本地开发用产物根（ARTIFACTS_ROOT 指到工作区内时使用）。
# 内含 .job-credentials.enc（任务密钥密文）与需求文档原文，绝不入库。
.local-artifacts/

# IDE / OS
.idea/
.vscode/
.DS_Store
services/frontend/tsconfig.tsbuildinfo
.rings/
.playwright-mcp/
# 本机 Claude Code 会话权限记录（含绝对路径，因人而异）
.claude/

# 本地工作记忆（会话日志/项目笔记，非源码，不入库）
.workbuddy/

